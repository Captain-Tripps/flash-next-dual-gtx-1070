#!/usr/bin/python3 -I
"""Set / show the GDDR5 memory clock offset (MHz, NVML) on every NVIDIA GPU. No X server needed.

    gpu-memoc show            # current offset + clocks (any user)
    gpu-memoc set 400         # apply +400 to all GPUs (root)
    gpu-memoc set 400 300     # per-GPU offsets, in index order (root)
    gpu-memoc off             # back to stock (root)

The boot unit gpu-memoc.service applies OFFSET from /etc/default/gpu-memoc.
"""
import ctypes as C, sys

nv = C.CDLL("libnvidia-ml.so.1")


def ok(r, what):
    if r != 0:
        nv.nvmlErrorString.restype = C.c_char_p
        sys.exit(f"{what}: NVML error {r} ({nv.nvmlErrorString(r).decode()})")


def handles():
    n = C.c_uint()
    ok(nv.nvmlDeviceGetCount_v2(C.byref(n)), "count")
    out = []
    for i in range(n.value):
        h = C.c_void_p()
        ok(nv.nvmlDeviceGetHandleByIndex_v2(i, C.byref(h)), f"gpu{i}")
        out.append(h)
    return out


def show(hs):
    for i, h in enumerate(hs):
        off, lo, hi, clk, ps = C.c_int(), C.c_int(), C.c_int(), C.c_uint(), C.c_int()
        nv.nvmlDeviceGetMemClkVfOffset(h, C.byref(off))
        nv.nvmlDeviceGetMemClkMinMaxVfOffset(h, C.byref(lo), C.byref(hi))
        nv.nvmlDeviceGetClockInfo(h, 2, C.byref(clk))          # NVML_CLOCK_MEM
        nv.nvmlDeviceGetPerformanceState(h, C.byref(ps))
        print(f"gpu{i}: mem offset {off.value:+d} MHz (range {lo.value}..{hi.value}), mem clock now {clk.value} MHz, P{ps.value}")


def main():
    ok(nv.nvmlInit_v2(), "init")
    hs = handles()
    cmd = sys.argv[1] if len(sys.argv) > 1 else "show"
    if cmd in ("set", "off"):
        vals = [0] if cmd == "off" else [int(v) for v in sys.argv[2:]]
        if not vals:
            sys.exit("usage: gpu-memoc set OFFSET [OFFSET_GPU1 ...]")
        if any(v < 0 or v > 1500 for v in vals):
            sys.exit("refusing offsets outside 0..1500")
        for i, h in enumerate(hs):
            v = vals[i] if i < len(vals) else vals[-1]
            ok(nv.nvmlDeviceSetMemClkVfOffset(h, C.c_int(v)), f"set gpu{i}")
    elif cmd != "show":
        sys.exit(__doc__)
    show(hs)


main()
